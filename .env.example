# CineBook Environment Configuration Template
# Duplicate this file as .env and fill in your local MySQL credentials

FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=cinebook_secret_key_change_in_production

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=cinebook
DB_POOL_SIZE=5
